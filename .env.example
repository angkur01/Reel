# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GROK_API_KEY="MY_GROK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Cloud Database configuration (For persistent data on Vercel / GitHub hosting)
# firebase-applet-config.json is included in the project root.
# You can also copy firebase-applet-config.json contents into FIREBASE_CONFIG in Vercel environment variables.
FIREBASE_PROJECT_ID="ai-studio-applet-webapp-479fe"
FIREBASE_API_KEY="AIzaSyCQj5JOrkWHCUyJUo3PdVjj6VgU7XdRCYU"
FIREBASE_APP_ID="1:17300429211:web:a1efc53ce188b9ba90a93e"
